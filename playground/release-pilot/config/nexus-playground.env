# Playground Nexus target for release-pilot testing.
# Copy to ~/.m2/settings.xml credentials separately — never commit secrets.

NEXUS_URL=https://finos-osera.repo.sonatype.app/repository/playground/
REPOSITORY_ID=osera-playground

# Skip vendor + FINOS OpenPGP signatures by default. See signing-setup.md to enable.
OSERA_SKIP_SIGN=1
